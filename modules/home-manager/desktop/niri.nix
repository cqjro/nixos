# niri: a scrollable-tiling Wayland compositor, shared by every graphical host
# as a selectable *backup* session (THEOCIDE and REGICIDE keep Hyprland as the
# default session; CHRONOCIDE uses niri only). Machine-specific values live in
# the host files, like hyprland.monitors / hyprland.bindel do:
#   niri.outputs, niri.touchpad.*, niri.brightnessBinds, niri.extraBinds ...
# in modules/hosts/<HOST>/home.nix and monitors.nix.
#
# The config is generated as ~/.config/niri/config.kdl and checked at build
# time with `niri validate`. Colours come from Stylix; the shell (bar, launcher,
# lock, idle, wallpaper, clipboard, screenshots) is Noctalia, started by its
# systemd user unit (modules/home-manager/desktop/noctalia-shell.nix).
{ ... }:
{
	flake.modules.nixos.niri = { config, lib, ... }: {
		programs.niri = {
			enable = true;
			# Nautilus is only the default FileChooser backend of the gnome
			# portal; the gtk portal (Nemo is the file manager) is enough and
			# keeps nautilus + its dependencies out of the closure.
			useNautilus = false;
		};

		# programs.niri registers the "niri" session through
		# services.displayManager.sessionPackages, so the noctalia-greeter lists
		# it; polkit, the portals and gnome-keyring are enabled by the module too.
		security.polkit.enable = true;

		# programs.niri sets services.displayManager.defaultSession to "niri" at
		# mkDefault priority, which clashes with Plasma's own default on the hosts
		# that run Plasma Bigscreen. Nothing here reads it (noctalia-greeter picks
		# the session from its --session argument), so just resolve the clash:
		# keep Plasma where it is enabled, niri otherwise.
		services.displayManager.defaultSession = lib.mkOverride 999 (
			if config.services.desktopManager.plasma6.enable then "plasma" else "niri"
		);
	};

	flake.modules.homeManager."niri" = { lib, config, pkgs, ... }: let
		cfg = config.niri;
		c = config.lib.stylix.colors.withHashtag;

		q = builtins.toJSON; # KDL string literal (JSON escapes are valid KDL)
		num = n: if builtins.isInt n then toString n else lib.strings.floatToString n;

		outputKdl = name: o: ''
			output ${q name} {
				${lib.optionalString (o.mode != null) "mode ${q o.mode}"}
				scale ${num o.scale}
				${lib.optionalString (o.position != null) "position x=${toString o.position.x} y=${toString o.position.y}"}
				${lib.optionalString (o.transform != null) "transform ${q o.transform}"}
				${lib.optionalString o.variableRefreshRate "variable-refresh-rate"}
			}
		'';

		workspaceBinds = lib.concatMapStrings (i: let
			key = if i == 10 then "0" else toString i;
		in ''
			Mod+${key} { focus-workspace ${toString i}; }
			Mod+Shift+${key} { move-window-to-workspace ${toString i}; }
		'') (lib.range 1 10);

		kdl = ''
			// Generated by modules/home-manager/desktop/niri.nix; edit the Nix, not this file.

			input {
				keyboard {
					xkb {
						layout ${q cfg.keyboardLayout}
					}
				}
				touchpad {
					${lib.optionalString cfg.touchpad.tap "tap"}
					${lib.optionalString cfg.touchpad.naturalScroll "natural-scroll"}
					${lib.optionalString cfg.touchpad.disableWhileTyping "dwt"}
					click-method ${q cfg.touchpad.clickMethod}
					scroll-factor ${num cfg.touchpad.scrollFactor}
				}
				// Hyprland's follow_mouse = 1; max-scroll-amount 0% never scrolls the
				// view just because the pointer rests on a partly visible column.
				focus-follows-mouse max-scroll-amount="0%"
			}

			${lib.concatStrings (lib.mapAttrsToList outputKdl cfg.outputs)}
			cursor {
				xcursor-theme ${q cfg.cursor.theme}
				xcursor-size ${toString cfg.cursor.size}
			}

			layout {
				gaps ${num cfg.gaps.inner}
				center-focused-column "never"
				struts {
					left ${num (cfg.gaps.outer - cfg.gaps.inner)}
					right ${num (cfg.gaps.outer - cfg.gaps.inner)}
					top ${num (cfg.gaps.outer - cfg.gaps.inner)}
					bottom ${num (cfg.gaps.outer - cfg.gaps.inner)}
				}
				default-column-width { proportion ${num cfg.columnWidth}; }
				preset-column-widths {
					proportion 0.33333
					proportion 0.5
					proportion 0.66667
					proportion 1.0
				}
				// border_size = 0 in the Hyprland config: no border; the focus ring is
				// opt-in (niri.focusRing) because scrollable columns hide who has focus.
				border { off; }
				${if cfg.focusRing then ''
				focus-ring {
					width 2
					active-color ${q c.base0D}
					inactive-color ${q c.base03}
				}'' else "focus-ring { off; }"}
				insert-hint { color ${q c.base0D}; }
				${if cfg.shadow then ''
				shadow {
					on
					softness 40
					spread 5
					offset x=0 y=5
					color "#00000090"
				}'' else ""}
			}

			// Flat overview backdrop (noctalia's [backdrop] section is off by default).
			overview {
				backdrop-color ${q c.base00}
			}

			prefer-no-csd
			hotkey-overlay { skip-at-startup; }
			screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

			environment {
				ELECTRON_OZONE_PLATFORM_HINT "wayland"
				OZONE_PLATFORM_HINT "wayland"
				XCURSOR_SIZE ${q (toString cfg.cursor.size)}
			}

			// noctalia starts from its systemd user unit (graphical-session.target),
			// so there is no spawn-at-startup for it here.
			spawn-at-startup "bash" "${../../../start.sh}"

			// Allows notification actions and window activation from Noctalia
			// (and Hyprland's focus_on_activate behaviour).
			debug { honor-xdg-activation-with-invalid-serial; }

			// Hyprland's special workspace "magic": a plain named workspace here.
			workspace "magic"

			window-rule {
				geometry-corner-radius ${num cfg.cornerRadius}
				clip-to-geometry true
			}
			// Noctalia's settings window floats (sized relative to the output).
			window-rule {
				match app-id="dev.noctalia.Noctalia"
				open-floating true
				default-column-width { proportion 0.8; }
				default-window-height { proportion 0.8; }
			}
			// Hyprland rule: Picture-in-Picture floats (pin has no niri equivalent).
			window-rule {
				match title="^Picture-in-Picture$"
				open-floating true
				default-floating-position x=20 y=20 relative-to="bottom-right"
			}
			// Hyprland rule: steam_app_<id> windows go to the magic workspace.
			window-rule {
				match app-id=r#"^steam_app_\d+$"#
				open-on-workspace "magic"
			}
			${lib.optionalString cfg.blur ''
			window-rule {
				background-effect {
					blur true
					xray false
				}
			}
			layer-rule {
				match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
				background-effect {
					xray false
				}
			}''}

			binds {
				// -- Hyprland mapping ------------------------------------------------
				Mod+Q { close-window; }
				Mod+V { toggle-window-floating; }
				Mod+F { fullscreen-window; }
				Alt+S { screenshot-screen; }
				Alt+Shift+S { screenshot; }

				Mod+H { focus-column-left; }
				Mod+L { focus-column-right; }
				Mod+J { focus-window-or-workspace-down; }
				Mod+K { focus-window-or-workspace-up; }

				${workspaceBinds}
				Mod+S { focus-workspace "magic"; }
				Mod+Shift+S { move-window-to-workspace "magic"; }
				Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
				Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

				// pip-move.sh (Mod+Alt+H/J/K/L) snaps the PiP window to a corner with
				// hyprctl; niri 26.04 has no action to move a floating window, so
				// drag it with Mod+left mouse (built in) instead.

				XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }
				XF86AudioPause allow-when-locked=true { spawn-sh "noctalia msg media playPause"; }
				XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media playPause"; }
				XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
				XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
				XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
				XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }

				// -- niri-only extras (letters used by the xremap chains are avoided) --
				Mod+Return { spawn ${q cfg.terminal}; }
				Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
				Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }
				Mod+Tab { toggle-overview; }
				Mod+Shift+Slash { show-hotkey-overlay; }
				Mod+Shift+E { quit; }

				Mod+Ctrl+H { move-column-left; }
				Mod+Ctrl+L { move-column-right; }
				Mod+Ctrl+J { move-window-down-or-to-workspace-down; }
				Mod+Ctrl+K { move-window-up-or-to-workspace-up; }
				Mod+Comma { consume-or-expel-window-left; }
				Mod+Period { consume-or-expel-window-right; }
				Mod+Minus { set-column-width "-10%"; }
				Mod+Equal { set-column-width "+10%"; }
				Mod+Shift+Minus { set-window-height "-10%"; }
				Mod+Shift+Equal { set-window-height "+10%"; }
				Mod+Shift+F { maximize-column; }
				Mod+Shift+C { center-column; }
				Mod+Shift+R { switch-preset-column-width; }

				// -- per-host (niri.brightnessBinds / niri.extraBinds) --
				${lib.concatStringsSep "\n" (cfg.brightnessBinds ++ cfg.extraBinds)}
			}

			${cfg.extraConfig}
		'';

		rawFile = pkgs.writeText "niri-config.kdl" kdl;

		# Fail the build (and so the host build) on an invalid config.
		configFile = pkgs.runCommand "niri-config.kdl" { nativeBuildInputs = [ pkgs.niri ]; } ''
			niri validate -c ${rawFile}
			cp ${rawFile} $out
		'';
	in {
		options.niri = {
			outputs = lib.mkOption {
				default = {};
				description = ''
					niri outputs by connector (`eDP-1`) or "Make Model Serial" name as
					printed by `niri msg outputs`. The niri counterpart of hyprland.monitors.
				'';
				type = lib.types.attrsOf (lib.types.submodule {
					options = {
						mode = lib.mkOption { type = lib.types.nullOr lib.types.str; default = null; example = "3840x2160@165.000"; };
						scale = lib.mkOption { type = lib.types.number; default = 1; };
						position = lib.mkOption {
							default = null;
							type = lib.types.nullOr (lib.types.submodule { options = {
								x = lib.mkOption { type = lib.types.int; default = 0; };
								y = lib.mkOption { type = lib.types.int; default = 0; };
							}; });
						};
						transform = lib.mkOption { type = lib.types.nullOr lib.types.str; default = null; example = "90"; };
						variableRefreshRate = lib.mkOption { type = lib.types.bool; default = false; };
					};
				});
			};

			keyboardLayout = lib.mkOption { type = lib.types.str; default = "us"; };

			touchpad = {
				tap = lib.mkOption { type = lib.types.bool; default = false; description = "tap-to-click (Hyprland: off)."; };
				naturalScroll = lib.mkOption { type = lib.types.bool; default = true; };
				disableWhileTyping = lib.mkOption { type = lib.types.bool; default = true; };
				clickMethod = lib.mkOption { type = lib.types.enum [ "clickfinger" "button-areas" ]; default = "clickfinger"; };
				scrollFactor = lib.mkOption { type = lib.types.number; default = 0.7; };
			};

			cursor = {
				theme = lib.mkOption { type = lib.types.str; default = if config.stylix.cursor != null then config.stylix.cursor.name else "default"; description = "Defaults to the Stylix cursor."; };
				size = lib.mkOption { type = lib.types.int; default = if config.stylix.cursor != null then config.stylix.cursor.size else 24; };
			};

			columnWidth = lib.mkOption { type = lib.types.number; default = 0.5; description = "default-column-width as a proportion of the output (1.0 = full width)."; };
			gaps = {
				inner = lib.mkOption { type = lib.types.number; default = 5; description = "Gap between windows (Hyprland gaps_in)."; };
				outer = lib.mkOption { type = lib.types.number; default = 15; description = "Gap to the screen edge (Hyprland gaps_out); applied as inner gap + struts."; };
			};
			cornerRadius = lib.mkOption { type = lib.types.number; default = 10; };
			focusRing = lib.mkOption { type = lib.types.bool; default = false; description = "Draw a Stylix-coloured focus ring (the Hyprland config has no border)."; };
			shadow = lib.mkOption { type = lib.types.bool; default = true; description = "Window shadows (Hyprland decoration.shadow)."; };
			blur = lib.mkOption { type = lib.types.bool; default = false; description = "Compositor blur behind windows and Noctalia surfaces (needs niri >= 26.04; GPU cost)."; };
			terminal = lib.mkOption { type = lib.types.str; default = "ghostty"; description = "Program for Mod+Return."; };

			brightnessBinds = lib.mkOption {
				type = lib.types.listOf lib.types.str;
				default = [];
				description = "Raw KDL bind lines for the brightness keys; the niri counterpart of hyprland.bindel.";
				example = [ ''XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl set 5%+"; }'' ];
			};
			extraBinds = lib.mkOption { type = lib.types.listOf lib.types.str; default = []; description = "Extra raw KDL bind lines appended to the binds block."; };
			extraConfig = lib.mkOption { type = lib.types.lines; default = ""; description = "Raw KDL appended to the generated config (host-specific nodes)."; };
		};

		config = {
			xdg.configFile."niri/config.kdl".source = configFile;
		};
	};
}
